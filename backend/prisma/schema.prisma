generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model aerolineas {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  esta_activo    Boolean?         @default(true)
  detalles_venta detalles_venta[]
}

model categorias_gasto {
  id          Int           @id @default(autoincrement())
  nombre      String        @db.VarChar(100)
  tipos_gasto tipos_gasto[]
}

model clientes {
  id                  BigInt         @id @default(autoincrement())
  primer_nombre       String         @db.VarChar(100)
  segundo_nombre      String?        @db.VarChar(100)
  primer_apellido     String         @db.VarChar(100)
  segundo_apellido    String?        @db.VarChar(100)
  nit                 String?        @db.VarChar(20)
  documento_identidad String?        @db.VarChar(30)
  direccion           String?
  telefono            String?        @db.VarChar(20)
  correo_electronico  String?        @db.VarChar(255)
  departamento_id     Int?
  deleted_at          DateTime?      @db.Timestamptz(6)
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?      @default(now()) @db.Timestamptz(6)
  departamentos       departamentos? @relation(fields: [departamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facturas            facturas[]
  ventas              ventas[]
}

model departamentos {
  id       Int        @id @default(autoincrement())
  nombre   String     @db.VarChar(100)
  clientes clientes[]
}

model detalles_venta {
  id                                            BigInt                  @id @default(autoincrement())
  venta_id                                      BigInt
  servicio_id                                   Int?
  tipo_viaje                                    tipo_viaje_opcion?
  origen_pais_id                                Int?
  destino_pais_id                               Int?
  cantidad_pasajeros                            Int                     @default(1)
  precio_boletos                                Decimal                 @default(0.00) @db.Decimal(12, 2)
  proveedor_id                                  Int?
  aerolinea_id                                  Int?
  detalles_especificos                          String?
  aerolineas                                    aerolineas?             @relation(fields: [aerolinea_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paises_detalles_venta_destino_pais_idTopaises paises?                 @relation("detalles_venta_destino_pais_idTopaises", fields: [destino_pais_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paises_detalles_venta_origen_pais_idTopaises  paises?                 @relation("detalles_venta_origen_pais_idTopaises", fields: [origen_pais_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  operadores_proveedores                        operadores_proveedores? @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servicios                                     servicios?              @relation(fields: [servicio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ventas                                        ventas                  @relation(fields: [venta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model facturas {
  id            BigInt    @id @default(autoincrement())
  venta_id      BigInt?
  cliente_id    BigInt?
  fecha_factura DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  total_factura Decimal   @db.Decimal(12, 2)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  clientes      clientes? @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ventas        ventas?   @relation(fields: [venta_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model gastos_fijos {
  id            Int              @id @default(autoincrement())
  nombre        String           @db.VarChar(150)
  monto         Decimal          @db.Decimal(12, 2)
  frecuencia    frecuencia_gasto @default(MENSUAL)
  tipo_gasto_id Int?
  esta_activo   Boolean?         @default(true)
  created_at    DateTime?        @default(now()) @db.Timestamptz(6)
  tipos_gasto   tipos_gasto?     @relation(fields: [tipo_gasto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model gastos_variables {
  id            BigInt       @id @default(autoincrement())
  fecha         DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date
  descripcion   String?
  monto         Decimal      @db.Decimal(12, 2)
  tipo_gasto_id Int?
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  tipos_gasto   tipos_gasto? @relation(fields: [tipo_gasto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model operadores_proveedores {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  esta_activo    Boolean?         @default(true)
  detalles_venta detalles_venta[]
}

model paises {
  id                                                    Int              @id @default(autoincrement())
  iso                                                   String           @db.VarChar(10)
  nombre                                                String           @db.VarChar(100)
  detalles_venta_detalles_venta_destino_pais_idTopaises detalles_venta[] @relation("detalles_venta_destino_pais_idTopaises")
  detalles_venta_detalles_venta_origen_pais_idTopaises  detalles_venta[] @relation("detalles_venta_origen_pais_idTopaises")
}

model servicios {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  esta_activo    Boolean?         @default(true)
  detalles_venta detalles_venta[]
}

model tipos_gasto {
  id                 Int                @id @default(autoincrement())
  nombre             String             @db.VarChar(100)
  categoria_gasto_id Int?
  gastos_fijos       gastos_fijos[]
  gastos_variables   gastos_variables[]
  categorias_gasto   categorias_gasto?  @relation(fields: [categoria_gasto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ventas {
  id                BigInt           @id @default(autoincrement())
  numero_recibo     String           @unique @db.VarChar(50)
  fecha_venta       DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  cliente_id        BigInt
  monto_recibo      Decimal          @default(0.00) @db.Decimal(12, 2)
  monto_neto        Decimal          @default(0.00) @db.Decimal(12, 2)
  comision_operador Decimal?         @default(0.00) @db.Decimal(12, 2)
  metodo_pago       tipo_metodo_pago @default(EFECTIVO)
  estado            estado_venta     @default(COMPLETADA)
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?        @default(now()) @db.Timestamptz(6)
  detalles_venta    detalles_venta[]
  facturas          facturas[]
  clientes          clientes         @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum estado_venta {
  COMPLETADA
  PENDIENTE
  ANULADA
}

enum frecuencia_gasto {
  SEMANAL
  QUINCENAL
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum tipo_metodo_pago {
  EFECTIVO
  TARJETA
}

enum tipo_viaje_opcion {
  SOLO_IDA
  IDA_Y_VUELTA
}
