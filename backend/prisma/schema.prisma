generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model aerolineas {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @updatedAt @db.Timestamptz(6)
  detalles_venta detalles_venta[]
}

model clientes {
  id                  BigInt         @id @default(autoincrement())
  primer_nombre       String         @db.VarChar(100)
  segundo_nombre      String?        @db.VarChar(100)
  primer_apellido     String         @db.VarChar(100)
  segundo_apellido    String?        @db.VarChar(100)
  nit                 String?        @db.VarChar(20)
  documento_identidad String?        @db.VarChar(30) @unique
  direccion           String?
  telefono            String?        @db.VarChar(20)
  correo_electronico  String?        @db.VarChar(255)
  departamento_id     Int?
  deleted_at          DateTime?      @db.Timestamptz(6)
  created_at          DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?      @updatedAt @db.Timestamptz(6)
  departamento        departamentos? @relation(fields: [departamento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  facturas            facturas[]
  ventas              ventas[]
}

model departamentos {
  id         Int        @id @default(autoincrement())
  nombre     String     @db.VarChar(100)
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at DateTime?  @updatedAt @db.Timestamptz(6)
  clientes   clientes[]
}

model detalles_venta {
  id                   BigInt                  @id @default(autoincrement())
  venta_id             BigInt
  servicio_id          Int?
  tipo_viaje           tipo_viaje_opcion?
  origen_pais_id       Int?
  destino_pais_id      Int?
  cantidad_pasajeros   Int                     @default(1)
  precio_unitario      Decimal                 @default(0.00) @db.Decimal(12, 2)
  proveedor_id         Int?
  aerolinea_id         Int?
  detalles_especificos String?
  created_at           DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?               @updatedAt @db.Timestamptz(6)
  aerolineas           aerolineas?             @relation(fields: [aerolinea_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pais_destino         paises?                 @relation("detalles_venta_destino", fields: [destino_pais_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pais_origen          paises?                 @relation("detalles_venta_origen", fields: [origen_pais_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  operadores_proveedores operadores_proveedores? @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servicios            servicios?              @relation(fields: [servicio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ventas               ventas                  @relation(fields: [venta_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model facturas {
  id            BigInt    @id @default(autoincrement())
  venta_id      BigInt?
  cliente_id    BigInt?
  fecha_factura DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  total_factura Decimal   @db.Decimal(12, 2)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @updatedAt @db.Timestamptz(6)
  clientes      clientes? @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ventas        ventas?   @relation(fields: [venta_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model catalogo_gastos {
  id              Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(150)
  monto_base      Decimal?          @db.Decimal(12, 2)
  frecuencia      frecuencia_gasto?
  tipo_gasto_id   Int
  deleted_at      DateTime?         @db.Timestamptz(6)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @updatedAt @db.Timestamptz(6)
  tipos_gasto     tipos_gasto       @relation(fields: [tipo_gasto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registro_gastos registro_gastos[]
}

model operadores_proveedores {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @updatedAt @db.Timestamptz(6)
  detalles_venta detalles_venta[]
}

model paises {
  id                     Int              @id @default(autoincrement())
  iso                    String           @db.VarChar(10)
  nombre                 String           @db.VarChar(100)
  created_at             DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?        @updatedAt @db.Timestamptz(6)
  detalles_venta_destino detalles_venta[] @relation("detalles_venta_destino")
  detalles_venta_origen  detalles_venta[] @relation("detalles_venta_origen")
}

model registro_gastos {
  id                BigInt          @id @default(autoincrement())
  fecha             DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  monto             Decimal         @db.Decimal(12, 2)
  descripcion_extra String?         @db.VarChar(255)
  catalogo_gasto_id Int
  deleted_at        DateTime?       @db.Timestamptz(6)
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?       @updatedAt @db.Timestamptz(6)
  catalogo_gastos   catalogo_gastos @relation(fields: [catalogo_gasto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model servicios {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @updatedAt @db.Timestamptz(6)
  detalles_venta detalles_venta[]
}

model tipos_gasto {
  id              Int                   @id @default(autoincrement())
  nombre          String                @db.VarChar(100)
  categoria_gasto categoria_gasto_enum?
  deleted_at      DateTime?             @db.Timestamptz(6)
  created_at      DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?             @updatedAt @db.Timestamptz(6)
  catalogo_gastos catalogo_gastos[]
}

model ventas {
  id                BigInt           @id @default(autoincrement())
  numero_recibo     String           @unique @db.VarChar(50)
  fecha_venta       DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  cliente_id        BigInt
  monto_recibo      Decimal          @default(0.00) @db.Decimal(12, 2)
  monto_neto        Decimal          @default(0.00) @db.Decimal(12, 2)
  comision_operador Decimal?         @default(0.00) @db.Decimal(12, 2)
  metodo_pago       tipo_metodo_pago @default(EFECTIVO)
  deleted_at        DateTime?        @db.Timestamptz(6)
  created_at        DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?        @updatedAt @db.Timestamptz(6)
  detalles_venta    detalles_venta[]
  facturas          facturas[]
  clientes          clientes         @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum categoria_gasto_enum {
  FIJO
  VARIABLE
}

enum frecuencia_gasto {
  SEMANAL
  QUINCENAL
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum tipo_metodo_pago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum tipo_viaje_opcion {
  SOLO_IDA
  IDA_Y_VUELTA
}

model Usuario {
  id         String    @id @default(uuid())
  nombre     String
  email      String    @unique
  password   String
  rol        Rol       @default(ADMIN)
  deleted_at DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum Rol {
  ADMIN
  VENDEDOR
}

